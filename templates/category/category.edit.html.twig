{% extends 'base.html.twig' %}

{% block title %}Modifier la catégorie{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Modifier la catégorie</h1>

        {{ form_start(form) }}
        {{ form_widget(form) }}

        <button type="submit" class="btn btn-primary mt-3">
            {{ button_label|default('Mettre à jour') }}
        </button>
        {{ form_end(form) }}

        <div class="mt-3">
            <a href="{{ path('app_category') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>
{% endblock %}
